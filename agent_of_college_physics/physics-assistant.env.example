# 大学物理智能助教 · Rocky Linux 运行配置
# 安装脚本会把本文件复制到当前目录的 config/physics-assistant.env。
# 该文件包含密钥，实际文件权限为 0600，请勿提交到 Git。

# tjracphy 本机 LM Studio 模型服务，不经过 LM Link 远端路由。
PHYSICS_BASE_URL=http://127.0.0.1:1235/v1
PHYSICS_MODEL=glm47-local-prod
PHYSICS_VISION_MODEL=qwen-vl30-local-prod
PHYSICS_API_KEY=
PHYSICS_CA_BUNDLE=
PHYSICS_CHAT_MODEL_KEY=zai-org/glm-4.7-flash
PHYSICS_CHAT_MODEL_IDENTIFIER=glm47-local-prod
PHYSICS_CHAT_MODEL_CONTEXT=8192
PHYSICS_CHAT_MODEL_PARALLEL=4
PHYSICS_VISION_MODEL_KEY=qwen/qwen3-vl-30b
PHYSICS_VISION_MODEL_IDENTIFIER=qwen-vl30-local-prod
PHYSICS_VISION_MODEL_CONTEXT=8192
PHYSICS_VISION_MODEL_PARALLEL=4
PHYSICS_CHAT_NO_THINK_SUFFIX=/nothink
PHYSICS_VISION_NO_THINK_SUFFIX=/no_think
PHYSICS_VISION_MAX_OUTPUT_TOKENS=1024

# 对话上下文。若模型实际上下文较小，请相应下调。
PHYSICS_CONTEXT_WINDOW=8192
PHYSICS_HISTORY_MAX_MESSAGES=4
PHYSICS_MAX_OUTPUT_TOKENS=1024
KB_CONTEXT_MAX_CHARS=2500

# 可选的按需联网搜索。只有明确要求搜索或涉及最新/近期信息时触发。
PHYSICS_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
PHYSICS_WEB_SEARCH_MAX_RESULTS=5
PHYSICS_WEB_SEARCH_TIMEOUT_SECONDS=8
PHYSICS_WEB_SEARCH_CACHE_MINUTES=30

# 首次新部署时可填写管理员配置；迁移已有 assistant.db 时会保留原账号。
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=课程管理员
ADMIN_PASSWORD=
ADMIN_TOKEN=

# 8501 是服务器内部统一网关；当前校园公开入口由 1234 HTTPS 反向代理提供。
ADMIN_LOGIN_URL=/admin-login
USER_SESSION_LOGIN_URL=/session-login
USER_SESSION_LOGOUT_URL=/session-logout
# 注册用户刷新页面后保持登录的时长，默认 7 天，允许范围 1 小时至 30 天。
PHYSICS_USER_SESSION_SECONDS=604800

PHYSICS_GATEWAY_HOST=0.0.0.0
PHYSICS_GATEWAY_PORT=8501
PHYSICS_STREAMLIT_UPSTREAM=http://127.0.0.1:8502
PHYSICS_ADMIN_UPSTREAM=http://127.0.0.1:8603

# 可选的用户级 HTTPS/WSS 网关；执行 bash setup_https.sh 后自动填写。
PHYSICS_GATEWAY_HTTPS_PORT=
PHYSICS_GATEWAY_TLS_CERT=
PHYSICS_GATEWAY_TLS_KEY=
PHYSICS_GATEWAY_PUBLIC_PREFIX=/agent

# Paraformer-zh-streaming：仅在回环地址提供服务，由 8501 网关转发 /asr/*。
PHYSICS_ASR_PORT=8604
PHYSICS_ASR_MODEL_DIR=
PHYSICS_ASR_THREADS=4
PHYSICS_ASR_BATCH_SIZE=4
PHYSICS_ASR_BATCH_WAIT_MS=8
PHYSICS_ASR_MAX_CONNECTIONS=4
PHYSICS_ASR_MAX_AUDIO_SECONDS=180
PHYSICS_ASR_IDLE_TIMEOUT_SECONDS=20
# 默认拒绝没有 Origin 的非浏览器 WebSocket；仅受控诊断客户端需要时才设为 1。
PHYSICS_ASR_ALLOW_MISSING_ORIGIN=0

# 经过子路径反向代理时填写浏览器看到的公开基址；末尾不要加斜杠。
# 当前生产部署入口为 https://192.168.222.147:1234/agent/
PHYSICS_PUBLIC_BASE_URL=https://192.168.222.147:1234/agent

# Julia/WGLMakie 实验。图形由访问者浏览器的 WebGL 渲染，服务器不需要 GPU。
PHYSICS_JULIA_EXE=
PHYSICS_EXPERIMENT_INSTANTIATE=false
JULIA_NUM_THREADS=2
# 电子荷质比实验只监听回环地址，公开路径为 /experiments/electron-em。
PHYSICS_ELECTRON_EM_PORT=9386
PHYSICS_ELECTRON_EM_UPSTREAM=http://127.0.0.1:9386
# 光电效应实验只监听回环地址，公开路径为 /experiments/photoelectric。
PHYSICS_PHOTOELECTRIC_PORT=9387
PHYSICS_PHOTOELECTRIC_UPSTREAM=http://127.0.0.1:9387
# 下面三个路径由 install.sh 按当前用户目录自动填写。
JULIA_DEPOT_PATH=
PHYSICS_SOUND_SPEED_OUTPUT_DIR=

# 可选：明确指定一个支持中文的字体文件。
PHYSICS_CJK_FONT=
