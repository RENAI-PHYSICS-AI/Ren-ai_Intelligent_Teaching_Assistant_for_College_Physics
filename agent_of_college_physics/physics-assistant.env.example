# 大学物理智能助教 · Rocky Linux 运行配置
# 安装脚本会把本文件复制到当前目录的 config/physics-assistant.env。
# 该文件包含密钥，实际文件权限为 0600，请勿提交到 Git。

# tjracphy 本机独立 MiMo-VL 服务，不经过 LM Link 或 LM Studio server 路由。
PHYSICS_BASE_URL=http://127.0.0.1:1237/v1
PHYSICS_MODEL=mimo-vl-local-prod
PHYSICS_VISION_MODEL=mimo-vl-local-prod
PHYSICS_API_KEY=
PHYSICS_CA_BUNDLE=
PHYSICS_CHAT_MODEL_KEY=xiaomi-mimo-vl-miloco-7b
PHYSICS_CHAT_MODEL_IDENTIFIER=mimo-vl-local-prod
PHYSICS_CHAT_MODEL_CONTEXT=128000
PHYSICS_CHAT_MODEL_PARALLEL=4
PHYSICS_VISION_MODEL_KEY=xiaomi-mimo-vl-miloco-7b
PHYSICS_VISION_MODEL_IDENTIFIER=mimo-vl-local-prod
PHYSICS_VISION_MODEL_CONTEXT=128000
PHYSICS_VISION_MODEL_PARALLEL=4
PHYSICS_CHAT_NO_THINK_SUFFIX=/no_think
PHYSICS_VISION_NO_THINK_SUFFIX=/no_think
PHYSICS_VISION_MAX_OUTPUT_TOKENS=2048
PHYSICS_VISION_TIMEOUT_SECONDS=360
# DeepSeek 使用 Direct I/O 绕过共享页缓存，并在 NUMA 1 建立 1M 上下文。
PHYSICS_MODEL_STARTUP_TIMEOUT_SECONDS=1800
# 生产保持 0；只有回退旧 LM Studio 1235 管理方式时才显式设为 1。
PHYSICS_USE_LEGACY_LM_STUDIO=0

# 教研考试独立路由到 DeepSeek AVX-512。API key 留空时回退 PHYSICS_API_KEY。
# DeepSeek 不接收 MiMo 专用的 /no_think 后缀，因此后缀必须保持空值。
PHYSICS_EXAM_BASE_URL=http://127.0.0.1:1236/v1
PHYSICS_EXAM_MODEL=deepseek/deepseek-v4-flash-avx512
PHYSICS_EXAM_API_KEY=
PHYSICS_EXAM_NO_THINK_SUFFIX=
PHYSICS_EXAM_TIMEOUT_SECONDS=1800
PHYSICS_EXAM_CONTEXT_WINDOW=1048576
PHYSICS_EXAM_MAX_OUTPUT_TOKENS=32768
# 完整试卷默认只生成一次，避免校验失败后静默整卷重做；允许范围 1-2。
PHYSICS_EXAM_GENERATION_ATTEMPTS=1
# 若整卷仅有重复选择题选项，最多追加一次只含问题题目的受限局部修复请求。
PHYSICS_EXAM_REPAIR_TIMEOUT_SECONDS=180
PHYSICS_EXAM_REPAIR_MAX_OUTPUT_TOKENS=4096

# 可选：独立 MiMo-VL Miloco 7B AVX2 用户级 systemd 服务。
# install_mimo_vl_avx2_service.sh 使用专用的
# ~/.config/physics-assistant/mimo-vl-avx2.env；路径与独立 LLAMA_API_KEY 只在该文件填写。
MIMO_VL_SERVER_BIN=""
MIMO_VL_MODEL_PATH=""
MIMO_VL_MMPROJ_PATH=""
MIMO_VL_MODEL_ALIAS=mimo-vl-local-prod
MIMO_VL_HOST=127.0.0.1
MIMO_VL_PORT=1237
MIMO_VL_CTX_SIZE=128000
MIMO_VL_PARALLEL=4
MIMO_VL_NUMA_NODE=0
MIMO_VL_CPU_LIST=0-127
MIMO_VL_THREADS=128
MIMO_VL_THREADS_BATCH=128
MIMO_VL_BATCH_SIZE=2048
MIMO_VL_UBATCH_SIZE=512

# 可选：独立 DeepSeek V4 Flash AVX-512 用户级 systemd 服务。
# install_deepseek_avx512_service.sh 使用专用的
# ~/.config/physics-assistant/deepseek-avx512.env；下列同名项只用于集中说明默认值，
# unit 不读取本文件。两个实际路径和独立 API key 只在专用文件填写，不要提交到 Git。
DEEPSEEK_AVX512_SERVER_BIN=""
DEEPSEEK_AVX512_MODEL_PATH=""
# llama-server 官方读取该环境变量，密钥不会进入进程 argv。
LLAMA_API_KEY=""
DEEPSEEK_AVX512_MODEL_ALIAS=deepseek/deepseek-v4-flash-avx512
DEEPSEEK_AVX512_HOST=127.0.0.1
DEEPSEEK_AVX512_PORT=1236
DEEPSEEK_AVX512_CTX_SIZE=1048576
DEEPSEEK_AVX512_PARALLEL=1
DEEPSEEK_AVX512_NUMA_NODE=1
DEEPSEEK_AVX512_CPU_LIST=128-255
DEEPSEEK_AVX512_THREADS=128
DEEPSEEK_AVX512_THREADS_BATCH=128
DEEPSEEK_AVX512_BATCH_SIZE=2048
DEEPSEEK_AVX512_UBATCH_SIZE=512

# 对话上下文。若模型实际上下文较小，请相应下调。
PHYSICS_CONTEXT_WINDOW=128000
PHYSICS_HISTORY_MAX_MESSAGES=4
PHYSICS_MAX_OUTPUT_TOKENS=4096
KB_CONTEXT_MAX_CHARS=2500

# 可选的按需联网搜索。只有明确要求搜索或涉及最新/近期信息时触发。
PHYSICS_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
PHYSICS_WEB_SEARCH_MAX_RESULTS=5
PHYSICS_WEB_SEARCH_TIMEOUT_SECONDS=8
PHYSICS_WEB_SEARCH_CACHE_MINUTES=30

# 首次新部署时可填写管理员配置；迁移已有 assistant.db 时会保留原账号。
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=课程管理员
ADMIN_PASSWORD=
ADMIN_TOKEN=

# 8501 是服务器内部统一网关；当前校园公开入口由 1234 HTTPS 反向代理提供。
ADMIN_LOGIN_URL=/admin-login
USER_SESSION_LOGIN_URL=/session-login
USER_SESSION_LOGOUT_URL=/session-logout
# 注册用户刷新页面后保持登录的时长，默认 7 天，允许范围 1 小时至 30 天。
PHYSICS_USER_SESSION_SECONDS=604800

PHYSICS_GATEWAY_HOST=0.0.0.0
PHYSICS_GATEWAY_PORT=8501
PHYSICS_STREAMLIT_UPSTREAM=http://127.0.0.1:8502
PHYSICS_ADMIN_UPSTREAM=http://127.0.0.1:8603

# 可选的用户级 HTTPS/WSS 网关；执行 bash setup_https.sh 后自动填写。
PHYSICS_GATEWAY_HTTPS_PORT=
PHYSICS_GATEWAY_TLS_CERT=
PHYSICS_GATEWAY_TLS_KEY=
PHYSICS_GATEWAY_PUBLIC_PREFIX=/agent

# Paraformer-zh-streaming：仅在回环地址提供服务，由 8501 网关转发 /asr/*。
PHYSICS_ASR_PORT=8604
PHYSICS_ASR_MODEL_DIR=
PHYSICS_ASR_THREADS=4
PHYSICS_ASR_BATCH_SIZE=4
PHYSICS_ASR_BATCH_WAIT_MS=8
PHYSICS_ASR_MAX_CONNECTIONS=4
PHYSICS_ASR_MAX_AUDIO_SECONDS=180
PHYSICS_ASR_IDLE_TIMEOUT_SECONDS=20
# 默认拒绝没有 Origin 的非浏览器 WebSocket；仅受控诊断客户端需要时才设为 1。
PHYSICS_ASR_ALLOW_MISSING_ORIGIN=0

# 经过子路径反向代理时填写浏览器看到的公开基址；末尾不要加斜杠。
# 当前生产部署入口为 https://192.168.222.147:1234/agent/
PHYSICS_PUBLIC_BASE_URL=https://192.168.222.147:1234/agent

# Julia/WGLMakie 实验。图形由访问者浏览器的 WebGL 渲染，服务器不需要 GPU。
PHYSICS_JULIA_EXE=
PHYSICS_EXPERIMENT_INSTANTIATE=false
JULIA_NUM_THREADS=2
# 电子荷质比实验只监听回环地址，公开路径为 /experiments/electron-em。
PHYSICS_ELECTRON_EM_PORT=9386
PHYSICS_ELECTRON_EM_UPSTREAM=http://127.0.0.1:9386
# 光电效应实验只监听回环地址，公开路径为 /experiments/photoelectric。
PHYSICS_PHOTOELECTRIC_PORT=9387
PHYSICS_PHOTOELECTRIC_UPSTREAM=http://127.0.0.1:9387
# 双棱镜实验只监听回环地址，公开路径为 /experiments/biprism。
PHYSICS_BIPRISM_PORT=9388
PHYSICS_BIPRISM_UPSTREAM=http://127.0.0.1:9388
# 牛顿环实验只监听回环地址，公开路径为 /experiments/newton-rings。
PHYSICS_NEWTON_RINGS_PORT=9389
PHYSICS_NEWTON_RINGS_UPSTREAM=http://127.0.0.1:9389
# 杨氏模量实验只监听回环地址，公开路径为 /experiments/young-modulus。
PHYSICS_YOUNG_MODULUS_PORT=9390
PHYSICS_YOUNG_MODULUS_UPSTREAM=http://127.0.0.1:9390
# 转动惯量实验只监听回环地址，公开路径为 /experiments/rotational-inertia。
PHYSICS_ROTATIONAL_INERTIA_PORT=9391
PHYSICS_ROTATIONAL_INERTIA_UPSTREAM=http://127.0.0.1:9391
# 粘滞系数实验只监听回环地址，公开路径为 /experiments/viscosity。
PHYSICS_VISCOSITY_PORT=9392
PHYSICS_VISCOSITY_UPSTREAM=http://127.0.0.1:9392
# 固体比热容实验只监听回环地址，公开路径为 /experiments/specific-heat。
PHYSICS_SPECIFIC_HEAT_PORT=9393
PHYSICS_SPECIFIC_HEAT_UPSTREAM=http://127.0.0.1:9393
# 弗兰克-赫兹实验只监听回环地址，公开路径为 /experiments/franck-hertz。
PHYSICS_FRANCK_HERTZ_PORT=9394
PHYSICS_FRANCK_HERTZ_UPSTREAM=http://127.0.0.1:9394
# 温度传感器实验只监听回环地址，公开路径为 /experiments/temperature-sensor。
PHYSICS_TEMPERATURE_SENSOR_PORT=9395
PHYSICS_TEMPERATURE_SENSOR_UPSTREAM=http://127.0.0.1:9395
# 惠斯通电桥实验只监听回环地址，公开路径为 /experiments/wheatstone-bridge。
PHYSICS_WHEATSTONE_BRIDGE_PORT=9396
PHYSICS_WHEATSTONE_BRIDGE_UPSTREAM=http://127.0.0.1:9396
# 霍尔效应实验只监听回环地址，公开路径为 /experiments/hall-effect。
PHYSICS_HALL_EFFECT_PORT=9397
PHYSICS_HALL_EFFECT_UPSTREAM=http://127.0.0.1:9397
# 铁磁滞回线实验只监听回环地址，公开路径为 /experiments/magnetic-hysteresis。
PHYSICS_MAGNETIC_HYSTERESIS_PORT=9398
PHYSICS_MAGNETIC_HYSTERESIS_UPSTREAM=http://127.0.0.1:9398

# 薄透镜焦距实验只监听回环地址，公开路径为 /experiments/thin-lens-focal。
PHYSICS_THIN_LENS_FOCAL_PORT=9399
PHYSICS_THIN_LENS_FOCAL_UPSTREAM=http://127.0.0.1:9399

# 三棱镜折射率实验只监听回环地址，公开路径为 /experiments/prism-refractive-index。
PHYSICS_PRISM_REFRACTIVE_INDEX_PORT=9400
PHYSICS_PRISM_REFRACTIVE_INDEX_UPSTREAM=http://127.0.0.1:9400

# 固体热传导系数实验只监听回环地址，公开路径为 /experiments/thermal-conductivity。
PHYSICS_THERMAL_CONDUCTIVITY_PORT=9401
PHYSICS_THERMAL_CONDUCTIVITY_UPSTREAM=http://127.0.0.1:9401
# 下面三个路径由 install.sh 按当前用户目录自动填写。
JULIA_DEPOT_PATH=
PHYSICS_SOUND_SPEED_OUTPUT_DIR=

# 可选：明确指定一个支持中文的字体文件。
PHYSICS_CJK_FONT=
