# MiMo-VL Miloco 7B 独立用户级服务配置。
# 安装器会复制到 ~/.config/physics-assistant/mimo-vl-avx2.env 并设置 0600 权限。
# 路径必须是 Rocky 服务器上的绝对路径；不要把真实路径或密钥提交到 Git。

# 使用现有 LM Studio AVX2 llama-server 二进制；不要填写 lms 命令路径。
MIMO_VL_SERVER_BIN=""
MIMO_VL_MODEL_PATH=""
MIMO_VL_MMPROJ_PATH=""
# llama-server 官方读取 LLAMA_API_KEY；不放入命令行，避免出现在进程 argv。
LLAMA_API_KEY=""

MIMO_VL_MODEL_ALIAS=mimo-vl-local-prod
MIMO_VL_HOST=127.0.0.1
MIMO_VL_PORT=1237

# MiMo 服务总上下文设置为 128000，常驻 4 个并行槽。
MIMO_VL_CTX_SIZE=128000
MIMO_VL_PARALLEL=4

# tjracphy 的第一个 NUMA 节点；服务严格绑定 node 0 内存和 CPU 0-127。
MIMO_VL_NUMA_NODE=0
MIMO_VL_CPU_LIST=0-127
MIMO_VL_THREADS=128
MIMO_VL_THREADS_BATCH=128

MIMO_VL_BATCH_SIZE=2048
MIMO_VL_UBATCH_SIZE=512
