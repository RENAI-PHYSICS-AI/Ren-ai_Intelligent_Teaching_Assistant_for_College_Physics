# Local OpenAI-compatible model service. Copy to secrets.toml and fill values.
physics_api_key = ""
physics_base_url = "https://192.168.222.147:1234/v1"
physics_model = "mimo-vl-local-prod"
physics_vision_model = "mimo-vl-local-prod"
physics_vision_max_output_tokens = "2048"
physics_chat_no_think_suffix = "/no_think"
physics_vision_no_think_suffix = "/no_think"
physics_vision_timeout_seconds = "360"
physics_ca_bundle = ".streamlit/physics-assistant-ca.crt"
physics_context_window = "128000"
physics_history_max_messages = "80"
physics_max_output_tokens = "4096"
# Optional dedicated teaching-exam route. Leave URL/model/key empty to fall
# back to the ordinary chat route; DeepSeek should normally use an empty suffix.
physics_exam_base_url = ""
physics_exam_model = ""
physics_exam_api_key = ""
physics_exam_no_think_suffix = ""
physics_exam_timeout_seconds = "900"
physics_exam_context_window = "1048576"
physics_exam_max_output_tokens = "32768"
physics_exam_repair_timeout_seconds = "180"
physics_exam_repair_max_output_tokens = "4096"

# Optional user-management and administrator dashboard settings.
# Use a unique password of at least 12 characters and a long random token.
admin_username = "admin"
admin_display_name = "课程管理员"
admin_password = ""
admin_token = ""
admin_login_url = "http://127.0.0.1:8603/admin-login"
